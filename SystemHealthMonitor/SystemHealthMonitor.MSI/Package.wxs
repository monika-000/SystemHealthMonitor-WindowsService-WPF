<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<Package Id="MPCorp.SystemHealthMonitor.MSI" Name="SystemHealthMonitor.MSI" Manufacturer="MPCorp" Version="1.0.0" InstallerVersion="500" Compressed="yes">
		<MajorUpgrade DowngradeErrorMessage="A newer version of this product is already installed." />

		<Feature Id="Main" Title="SystemHealthMonitor" Level="1">
			<ComponentGroupRef Id="HarvestComponent"/>
			<ComponentGroupRef Id="WPFAppComponent" />
			<ComponentGroupRef Id="WindowsServiceComponent" />
			<ComponentRef Id="SettingsConfigComponent" />
			<ComponentRef Id="ResultsJsonComponent" />
		</Feature>

	</Package>
	<Fragment>
		<Icon Id="WpfIcon" SourceFile="$(var.SolutionDirectory)\..\out\Icons\SystemHealthMonitor.ico"/>
	</Fragment>
</Wix>
