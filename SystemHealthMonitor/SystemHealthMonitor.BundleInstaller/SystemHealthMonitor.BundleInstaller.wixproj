<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
	  <AcceptEula>wix7</AcceptEula>
	  <DefineConstants>SolutionDirectory=$(MSBuildProjectDirectory)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="7.0.0" />
	<PackageReference Include="WixToolset.NetFx.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
