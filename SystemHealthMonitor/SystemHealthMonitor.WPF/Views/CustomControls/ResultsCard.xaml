<UserControl x:Class="SystemHealthMonitor.WPF.Views.CustomControls.ResultsCard"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SystemHealthMonitor.WPF.Views.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Header -->
        <Style x:Key="CardHeader" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize"  Value="20"/>
        </Style>
        <!-- Border -->
        <Style x:Key="CardBorder" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="15"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="VerticalAlignment"  Value="Top"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
        </Style>
        <!-- DataGrid style -->
        <Style x:Key="ResultsDataGrid" TargetType="{x:Type DataGrid}">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
            <Setter Property="ColumnHeaderStyle" Value="{DynamicResource ColumnHeaderStyle}"/>
            <Setter Property="CellStyle" Value="{DynamicResource DataGridCellStyle}" />
            <Setter Property="BorderBrush" Value="#A5D4DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AlternatingRowBackground" Value="#99A5D4DD"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="WhiteSmoke"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
        </Style>
        <!-- DataGridColumnHeader style -->
        <Style x:Key="ColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#008190" />
            <Setter Property="BorderBrush" Value="#A5D4DD"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <!--<Setter Property="SeparatorBrush" Value="#A5D4DD"/>-->
            <Setter Property="SeparatorVisibility" Value="Visible"/>
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <!-- DataGridCellStyle style -->
        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="7, 10, 10, 10" />
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Border Grid.Column="1" Style="{DynamicResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{DynamicResource CardHeader}" Text="{Binding CardTitle, ElementName=Root}"/>
                <DataGrid Grid.Row="1" Style="{DynamicResource ResultsDataGrid}" ItemsSource="{Binding CardItems, ElementName=Root}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Metric" Width="65*" Binding="{Binding Metric}" />
                        <DataGridTextColumn Header="Value (%)" Width="35*"  Binding="{Binding Value}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>