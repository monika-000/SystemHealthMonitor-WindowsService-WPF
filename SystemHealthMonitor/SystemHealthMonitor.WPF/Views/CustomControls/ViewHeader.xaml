<UserControl x:Class="SystemHealthMonitor.WPF.Views.CustomControls.ViewHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SystemHealthMonitor.WPF.Views.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="ViewHeader" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Padding" Value="20, 15"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <TextBlock Text ="{Binding Title}"  Style="{DynamicResource ViewHeader}"/>
    </Grid>
</UserControl>
