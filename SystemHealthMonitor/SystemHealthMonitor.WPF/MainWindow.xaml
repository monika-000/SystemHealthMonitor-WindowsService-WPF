<Window x:Class="SystemHealthMonitor.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SystemHealthMonitor.WPF.ViewModels"
        xmlns:views="clr-namespace:SystemHealthMonitor.WPF.Views"
        xmlns:cc="clr-namespace:SystemHealthMonitor.WPF.Views.CustomControls"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="System Health Monitor" Height="500" Width="895" FontFamily="Microsoft YaHei" Background="#F5F5F5">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Navigation -->
            <ColumnDefinition Width="200" />
            <!-- Screen Content -->
            <ColumnDefinition Width="100*" />
        </Grid.ColumnDefinitions>
        <!-- Left Navigation Panel -->
        <cc:VerticalNavBar DataContext="{Binding}" />
        <!-- Right Content Panel -->
        <ContentControl x:Name ="MainContentControl" Grid.Column="1" />
    </Grid>
</Window>
